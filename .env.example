# Streaming microphone transcription. See docs/STREAMING_ASR.md.
# Copy settings into an existing .env; preserve your current chat/TTS keys.
# local requires no transcription API key. The conversational agent can still
# use the existing hosted chat/TTS providers and needs their own credentials.
LIVE_STT_PROVIDER=local
LIVE_STT_LANGUAGE=uz

# Multilingual CTranslate2 model: large-v3, large-v3-turbo, or a local CT2 path.
# Model weights are downloaded on first use unless already available locally.
LIVE_STT_LOCAL_MODEL=large-v3
LIVE_STT_LOCAL_DEVICE=auto
# auto selects float16 on CUDA and int8 on CPU. No silent smaller-model fallback.
LIVE_STT_LOCAL_COMPUTE_TYPE=auto
LIVE_STT_LOCAL_CPU_THREADS=4
LIVE_STT_LOCAL_BEAM_SIZE=5

# Milliseconds except MAX_SEGMENT_SECONDS and MAX_TURN_SECONDS.
# These are scheduling/endpoint settings, not achieved latency measurements.
LIVE_STT_PARTIAL_INTERVAL_MS=800
LIVE_STT_SILENCE_MS=600
LIVE_STT_MIN_SPEECH_MS=128
LIVE_STT_PREFIX_MS=320
LIVE_STT_MAX_SEGMENT_SECONDS=15
LIVE_STT_MAX_TURN_SECONDS=120
LIVE_STT_MAX_PENDING_SEGMENTS=4
LIVE_STT_MAX_SESSIONS=2
LIVE_STT_VAD_THRESHOLD=0.5

# Optional short vocabulary hint. Omit to use locale-specific defaults.
# Do not put a full script or invented customer details here.
# LIVE_STT_VOCABULARY_HINTS="buyurtma, buyurtmani, buyurtmam, Sahiy, kuryer, to'lov"

# Optional hosted STT: set LIVE_STT_PROVIDER=openai and supply a server-side key.
# Existing agent chat and OpenAI TTS also use this key when enabled.
OPENAI_API_KEY=
LIVE_STT_MODEL=gpt-4o-transcribe

# Existing conversational-agent provider settings (independent of local ASR).
LIVE_AGENT_MODEL=gpt-4o-mini
LIVE_AGENT_TTS_PROVIDER=edge_tts
# Optional override; omit to choose a voice for the session language.
# LIVE_AGENT_EDGE_VOICE=uz-UZ-SardorNeural
LIVE_AGENT_TTS_MODEL=gpt-4o-mini-tts
LIVE_AGENT_VOICE=coral
